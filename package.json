{
  "name": "@bridgephase/pylon-ui",
  "version": "0.0.16",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "prepack": "json -f package.json -I -e",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@emotion/react": "^11.11.4",
    "@mantine/charts": "^8.1.1",
    "@mantine/core": "8.1.1",
    "@mantine/dates": "8.1.1",
    "@mantine/emotion": "8.1.1",
    "@mantine/form": "8.1.1",
    "@mantine/hooks": "8.1.1",
    "@tabler/icons-react": "^3.4.0",
    "@uswds/uswds": "^3.11.0",
    "@vitest/coverage-v8": "^1.6.0",
    "react": "^18.3.1",
    "react-compare-slider": "^3.1.0",
    "react-dom": "^18.3.1",
    "react-imask": "^7.6.1",
    "react-router-dom": "^7.2.0",
    "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@storybook/react-vite": "^9.0.9",
    "@testing-library/dom": "^9.3.1",
    "@testing-library/jest-dom": "^6.1.3",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.4.3",
    "@types/jest": "^29.5.4",
    "@types/node": "^20.6.0",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react": "^4.0.3",
    "@vitest/ui": "^1.6.0",
    "eslint": "^8.45.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "eslint-plugin-storybook": "^9.0.9",
    "sass": "^1.85.0",
    "storybook": "^9.0.9",
    "typescript": "^5.0.2",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^3.7.0",
    "vitest": "^1.6.0"
  },
  "msw": {
    "workerDirectory": "public"
  },
  "packageManager": "yarn@3.6.3",
  "files": [
    "dist"
  ],
  "main": "./dist/pylon-ui.umd.cjs",
  "types": "./dist/pylon-ui.d.ts",
  "exports": {
    ".": {
      "import": "./dist/pylon-ui.js",
      "require": "./dist/pylon-ui.umd.cjs"
    },
    "./dist/*.css": {
      "import": "./dist/*.css",
      "require": "./dist/*.css"
    }
  }
}
