{
  "name": "@bridgephasenpm/pylon-ui",
  "version": "0.0.37",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BridgePhase/pylon-ui.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@mantine/charts": "^8.3.9",
    "@mantine/core": "8.3.9",
    "@mantine/dates": "8.3.9",
    "@mantine/emotion": "8.3.9",
    "@mantine/form": "8.3.9",
    "@mantine/hooks": "8.3.9",
    "@tabler/icons-react": "^3.35.0",
    "@uswds/uswds": "^3.13.0",
    "clsx": "^2.1.1",
    "react-compare-slider": "^3.1.0",
    "react-hook-form": "^7.67.0",
    "react-imask": "^7.6.1",
    "react-router-dom": "^7.9.6",
    "recharts": "^3.5.1"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/jest": "30.0.0",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.70.1",
    "@typescript-eslint/parser": "8.70.1",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/ui": "4.1.11",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "eslint-plugin-storybook": "10.6.0",
    "jsdom": "29.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sass": "1.105.0",
    "storybook": "10.6.0",
    "storybook-addon-tag-badges": "^3.1.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vite": "7.3.6",
    "vite-plugin-dts": "4.5.4",
    "vitest": "4.1.11"
  },
  "msw": {
    "workerDirectory": "public"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/pylon-ui.umd.cjs",
  "types": "./dist/pylon-ui.d.ts",
  "exports": {
    ".": {
      "import": "./dist/pylon-ui.js",
      "require": "./dist/pylon-ui.umd.cjs"
    },
    "./dist/*.css": {
      "import": "./dist/*.css",
      "require": "./dist/*.css"
    }
  }
}
