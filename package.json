    "prepack": "json -f package.json -I -e \"delete this.devDependencies; delete this.dependencies\""
  },
  "dependencies": {
    "@emotion/react": "^11.11.4",
    "@mantine/core": "^7.9.2",
    "@mantine/emotion": "^7.9.2",
    "@mantine/form": "^7.9.2",
    "@mantine/hooks": "^7.9.2",
    "@tabler/icons-react": "^3.4.0",
    "@uswds/uswds": "^3.8.0",
    "@vitest/coverage-v8": "^1.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^1",
    "@storybook/addon-essentials": "^8.1.3",
    "@storybook/addon-interactions": "^8.1.3",
    "@storybook/addon-links": "^8.1.3",
    "@storybook/addon-mdx-gfm": "^8.1.3",
    "@storybook/addon-onboarding": "^8.1.3",
    "@storybook/addon-styling-webpack": "^1.0.0",
    "@storybook/blocks": "^8.1.3",
    "@storybook/client-logger": "^8.1.3",
    "@storybook/preview-api": "^8.1.3",
    "@storybook/react": "^8.1.3",
    "@storybook/react-vite": "^8.1.3",
    "@storybook/test": "^8.1.3",
    "@storybook/testing-react": "^2.0.1",
    "@storybook/types": "^8.1.3",
    "@testing-library/dom": "^9.3.1",
    "@testing-library/jest-dom": "^6.1.3",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.4.3",
    "@types/jest": "^29.5.4",
    "@types/node": "^20.6.0",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@types/testing-library__jest-dom": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react": "^4.0.3",
    "@vitest/ui": "^1.6.0",
    "eslint": "^8.45.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "eslint-plugin-storybook": "^0.8.0",
    "storybook": "^8.1.3",
    "storybook-dark-mode": "^4.0.1",
    "typescript": "^5.0.2",
    "vite": "^4.4.5",
    "vite-plugin-dts": "^3.7.0",
    "vitest": "^1.6.0"
  },
  "msw": {
    "workerDirectory": "public"
  },
  "packageManager": "yarn@3.6.3",
  "files": [
    "dist"
  ],
  "main": "./dist/pylon-ui.umd.cjs",
  "types": "./dist/pylon-ui.d.ts",
  "exports": {
    ".": {
      "import": "./dist/pylon-ui.js",
