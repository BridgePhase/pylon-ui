{
  "name": "@bridgephase/pylon-ui",
  "version": "0.0.36",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "@bridgephase:registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BridgePhase/pylon-ui.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@mantine/charts": "^8.3.9",
    "@mantine/core": "8.3.9",
    "@mantine/dates": "8.3.9",
    "@mantine/emotion": "8.3.9",
    "@mantine/form": "8.3.9",
    "@mantine/hooks": "8.3.9",
    "@tabler/icons-react": "^3.35.0",
    "@uswds/uswds": "^3.13.0",
    "react": "^19.2.0",
    "react-compare-slider": "^3.1.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.67.0",
    "react-imask": "^7.6.1",
    "react-router-dom": "^7.9.6",
    "recharts": "^3.5.1"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.1.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.48.0",
    "@typescript-eslint/parser": "^8.48.0",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.0.14",
    "@vitest/ui": "^4.0.14",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "eslint-plugin-storybook": "^10.1.2",
    "jsdom": "^29.1.1",
    "sass": "^1.94.2",
    "storybook": "^10.1.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.0",
    "vite": "^7.2.6",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.0.14"
  },
  "msw": {
    "workerDirectory": "public"
  },
  "packageManager": "yarn@3.6.3",
  "files": [
    "dist"
  ],
  "main": "./dist/pylon-ui.umd.cjs",
  "types": "./dist/pylon-ui.d.ts",
  "exports": {
    ".": {
      "import": "./dist/pylon-ui.js",
      "require": "./dist/pylon-ui.umd.cjs"
    },
    "./dist/*.css": {
      "import": "./dist/*.css",
      "require": "./dist/*.css"
    }
  }
}
